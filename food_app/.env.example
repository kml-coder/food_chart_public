# Copy to food_app/.env for local development.
#
# Leave EXPO_PUBLIC_API_URL empty (or unset) when the Flask server also serves
# the web bundle (the all-in-one Hugging Face Space image).
# Set it to an absolute URL when the frontend runs on its own dev server.
EXPO_PUBLIC_API_URL=http://localhost:5050

# Comma separated list shown in the model picker.
# Hosted builds use "deberta" only; Ollama backends need a local Ollama daemon.
EXPO_PUBLIC_MODEL_OPTIONS=deberta,phi3,llama3:8b,t5
