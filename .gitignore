# ------------------------------------------------------------
# Runtime-minimal allowlist
# Keep only files needed to run frontend/backend + docs.
# Everything else is ignored by default.
# ------------------------------------------------------------
*

# NOTE: the secrets block lives at the BOTTOM of this file.
# Last matching pattern wins, and the `!food_app/**` allowlist below would
# otherwise re-include any .env inside an allowed directory.

# root-level files to keep
!.gitignore
!.dockerignore
!.gcloudignore
!README.md
!DOCKER.md
!DEPLOY.md
!Dockerfile
!requirements.txt
!docker-compose.yml
!docker-compose.deploy.yml

# deployment
!deploy/
!deploy/**
!scripts/
!scripts/**

# docker + CI
!docker/
!docker/**
!.github/
!.github/workflows/
!.github/workflows/**

# app + server runtime code
!food_app/
!food_app/**
!food_server/
!food_server/**
!food_model/
!food_model/gptgram_model/
!food_model/gptgram_model/final_unit_removed.json
# baseline evaluation — numpy-only, runs against the tracked dataset above.
# This is the evidence behind the "does the model beat a lookup table?" table
# in README.md, so it has to ship with the repo.
!food_model/gptgram_model/eval_baselines.py


# docs (readmes + images)
!docs/
!docs/**

# original hand-written UI, kept for reference (not built or served)
!backup/
!backup/**

# optional training code is excluded in runtime-minimal mode
# (uncomment if you want to track training scripts/notebooks again)
# !food_model/
# !food_model/**

# ------------------------------------------------------------
# noise / local artifacts (still ignored even if parent is allowed)
# ------------------------------------------------------------
.DS_Store
**/.DS_Store
**/.vscode/
**/.idea/
**/__pycache__/
**/*.pyc
**/.ipynb_checkpoints/

.venv/
venv/
env/
**/.venv/
**/venv/
**/env/

# logs
*.log
**/*.log

artifacts/
**/*.pt
**/*.bin
**/*.safetensors
**/*.ckpt

# JS / frontend dependencies and caches (any directory)
**/node_modules/
**/.expo/
**/.next/
**/dist/
**/web-dist/
**/build/
**/.cache/
**/coverage/
**/.turbo/
**/.pnpm-store/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*


# ------------------------------------------------------------
# secrets — MUST stay last so no allowlist above can re-include them
# ------------------------------------------------------------
**/.env
**/.env.*
**/*.pem
**/*.key
!food_app/.env.example
